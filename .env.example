# Copy to .env and fill in. .env is gitignored; never commit real keys.
ANTHROPIC_API_KEY=

# auto = live if a key is set, else mock. mock = never call the API.
LLM_MODE=auto

# Hard cap on total live LLM spend (USD). At the cap, FINN falls back to recorded/mock outputs.
BUDGET_USD_TOTAL=5.0

# Public demo guards (set PUBLIC_DEMO=true on the hosted API)
PUBLIC_DEMO=false
DAILY_USD_CAP=0.25
DAILY_LIVE_CALLS=20
PER_IP_DAILY_CALLS=3

# Comma-separated origins allowed to call the API (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# Front end (web/.env.local or Vercel env): where the API lives. Empty = same origin / dev proxy.
# VITE_API_BASE=https://your-name-finn-api.hf.space
