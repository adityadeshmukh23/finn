# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Provider keys (only the providers your slots use need one) ---
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, paid: only if you point a slot at provider "anthropic"
ANTHROPIC_API_KEY=

# auto = live for any slot whose provider has a key, else mock/recorded. mock = never call an API.
LLM_MODE=auto

# --- Model slots: provider, model, price (USD per 1M tokens; 0 on a free tier) and rate limits ---
# Bulk extraction and classification.
LLM_CHEAP_PROVIDER=gemini
LLM_CHEAP_MODEL=gemini-3.5-flash-lite
LLM_CHEAP_PRICE_IN=0
LLM_CHEAP_PRICE_OUT=0
# Set these to what https://aistudio.google.com/rate-limit shows for your project.
LLM_CHEAP_RPM=10
LLM_CHEAP_RPD=500

# Judgement tasks: promised-vs-delivered verdicts, bull/bear. Swap in a stronger model here.
LLM_STRONG_PROVIDER=gemini
LLM_STRONG_MODEL=gemini-3.6-flash
LLM_STRONG_PRICE_IN=0
LLM_STRONG_PRICE_OUT=0
LLM_STRONG_RPM=5
LLM_STRONG_RPD=20
# Example paid swap:
# LLM_STRONG_PROVIDER=anthropic
# LLM_STRONG_MODEL=claude-sonnet-5-5
# LLM_STRONG_PRICE_IN=2.00
# LLM_STRONG_PRICE_OUT=10.00
# LLM_STRONG_PRICE_CACHE_READ=0.20
# LLM_STRONG_RPM=0
# LLM_STRONG_RPD=0

# Longest a call waits for a free per-minute slot before falling back (seconds).
LLM_RATE_WAIT_MAX=20
# Per-request timeout (seconds). An overloaded model (503) gets one quick retry, then falls back.
LLM_TIMEOUT=90

# Hard cap on total paid LLM spend (USD). Free-tier calls cost $0 and never hit it.
BUDGET_USD_TOTAL=5.0

# Public demo guards (set PUBLIC_DEMO=true on the hosted API)
PUBLIC_DEMO=false
DAILY_USD_CAP=0.25
DAILY_LIVE_CALLS=20
PER_IP_DAILY_CALLS=3

# Comma-separated origins allowed to call the API (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# Front end (web/.env.local or Vercel env): where the API lives. Empty = same origin / dev proxy.
# VITE_API_BASE=https://your-name-finn-api.hf.space
